{
  "permissions": {
    "ask": [
      "Edit(/tools/**)",
      "Edit(/setup.sh)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/.codex/**)",
      "Edit(/.agents/**)",
      "Edit(/instance/config.json)",
      "Edit(/instance/rules.md)",
      "Edit(/state/.gate-baseline.json)",
      "Edit(/state/.gate-baseline.prev.json)",
      "Edit(/state/.gate-adopted.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tools/hook.sh\" event SessionStart claude",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tools/hook.sh\" event UserPromptSubmit claude",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tools/hook.sh\" event PostToolUse claude",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tools/hook.sh\" event Stop claude",
            "timeout": 190
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tools/hook.sh\" event PreCompact claude",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
