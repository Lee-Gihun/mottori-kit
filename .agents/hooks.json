{
  "kit": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "sh ../tools/hook.sh event SessionStart agy",
        "timeout": 30
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "sh ../tools/hook.sh event PreInvocation agy",
        "timeout": 15
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh ../tools/hook.sh event PostToolUse agy",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "sh ../tools/hook.sh event Stop agy",
        "timeout": 190
      }
    ]
  }
}
